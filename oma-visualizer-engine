#!/usr/bin/env python3
"""
OmaOpus Real-Time Audio Visualizer Engine
Captures live audio from PulseAudio/PipeWire monitor and computes 16-band FFT,
dynamic auto-gain control (AGC), and sharp beat/kick transient detection for the
Christopher Nolan Gargantua Black Hole visualizer.
"""

import sys
import os
import signal
import subprocess
import time
import numpy as np

CHUNK_SIZE = 512
BYTES_PER_CHUNK = CHUNK_SIZE * 2
SAMPLE_RATE = 22050

# Hanning window for smooth spectral leakage control
WINDOW = np.hanning(CHUNK_SIZE).astype(np.float32)

# 16 log-spaced frequency bands across 22050 Hz (Nyquist 11025 Hz, ~43 Hz / bin)
BIN_EDGES = [1, 2, 3, 5, 8, 12, 18, 26, 38, 54, 76, 105, 140, 180, 220, 256]
BIN_RANGES = [(BIN_EDGES[i], BIN_EDGES[i+1]) for i in range(len(BIN_EDGES)-1)]
NUM_BANDS = len(BIN_RANGES)

def spawn_recorder():
    # Attempt 1: parecord directly from default monitor with 20ms low-latency
    try:
        proc = subprocess.Popen(
            [
                'parecord',
                '--latency-msec=20',
                '--raw',
                f'--rate={SAMPLE_RATE}',
                '--channels=1',
                '--format=s16le'
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=BYTES_PER_CHUNK * 4
        )
        time.sleep(0.04)
        if proc.poll() is None:
            return proc
    except Exception:
        pass

    # Attempt 2: Target OmaOpus PipeWire stream
    try:
        proc = subprocess.Popen(
            [
                'pw-record',
                '--target=OmaOpus',
                '--raw',
                f'--rate={SAMPLE_RATE}',
                '--channels=1',
                '--format=s16',
                '-'
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=BYTES_PER_CHUNK * 4
        )
        time.sleep(0.04)
        if proc.poll() is None:
            return proc
    except Exception:
        pass

    # Attempt 3: General pw-record fallback
    try:
        proc = subprocess.Popen(
            [
                'pw-record',
                '--raw',
                f'--rate={SAMPLE_RATE}',
                '--channels=1',
                '--format=s16',
                '-'
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=BYTES_PER_CHUNK * 4
        )
        return proc
    except Exception:
        return None

def main():
    proc = spawn_recorder()
    if not proc:
        sys.stderr.write("Failed to start audio recorder process.\n")
        sys.exit(1)

    def cleanup(sig=None, frame=None):
        try:
            if proc and proc.poll() is None:
                proc.terminate()
                proc.wait(timeout=0.1)
        except Exception:
            pass
        os._exit(0)

    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGPIPE, cleanup)

    peaks = np.ones(NUM_BANDS, dtype=np.float32) * 1.5
    prev_bass = 0.5
    bass_history = []
    silence_frames = 0

    while True:
        try:
            raw = proc.stdout.read(BYTES_PER_CHUNK)
            if not raw or len(raw) < BYTES_PER_CHUNK:
                silence_frames += 1
                if silence_frames > 8:
                    time.sleep(0.03)
                continue

            silence_frames = 0
            samples = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0

            # Windowed FFT
            fft = np.abs(np.fft.rfft(samples * WINDOW))

            raw_bands = np.zeros(NUM_BANDS, dtype=np.float32)
            for idx, (low, high) in enumerate(BIN_RANGES):
                sub = fft[low:high]
                if len(sub) > 0:
                    raw_bands[idx] = float(np.mean(sub))

            # Dynamic Auto-Gain Control (AGC): rolling peak decay ensures full 0..1 scale
            peaks = np.maximum(raw_bands, peaks * 0.94)
            peaks = np.maximum(peaks, 0.25)
            norm = np.clip(raw_bands / peaks, 0.0, 1.0)

            # Frequency band groups
            bass = float(np.mean(norm[0:3]))
            mid = float(np.mean(norm[3:9]))
            high = float(np.mean(norm[9:]))
            energy = float(np.mean(norm))

            # Dual-stage beat detection:
            # 1. Onset transient (sharp rising delta in bass)
            delta = bass - prev_bass
            prev_bass = bass

            # 2. Running energy baseline
            bass_history.append(bass)
            if len(bass_history) > 24:
                bass_history.pop(0)
            avg_bass = float(np.mean(bass_history)) if bass_history else 0.1

            is_transient = (delta > 0.15 and bass > 0.45)
            is_surge = (bass > avg_bass * 1.35 and bass > 0.40)
            beat = 1.0 if (is_transient or is_surge) else 0.0

            bands_str = ",".join(f"{x:.2f}" for x in norm)
            payload = f'{{"b":[{bands_str}],"bass":{bass:.2f},"mid":{mid:.2f},"high":{high:.2f},"energy":{energy:.2f},"beat":{beat:.1f}}}\n'

            sys.stdout.write(payload)
            sys.stdout.flush()

        except (IOError, BrokenPipeError, KeyboardInterrupt):
            break
        except Exception:
            time.sleep(0.02)

    cleanup()

if __name__ == '__main__':
    main()
